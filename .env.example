# Copy this file to `.env.local` and fill in real values.
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored and must never be committed. This file holds
# NAMES ONLY — never put a real secret here, because this file IS committed.
#
# Step-by-step instructions for obtaining each value live in `Todo/`.

# --- Database (Todo/01) -------------------------------------------------
# From Neon. DATABASE_URL is the POOLED connection (host contains "-pooler")
# and is what the running app uses. DIRECT_URL is the UNPOOLED connection and
# is what Prisma migrations need. Both are passwords.
DATABASE_URL=""
DIRECT_URL=""

# --- Authentication (Todo/02) -------------------------------------------
# From Google Cloud Console. Authorised redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated allowlist of addresses permitted to sign in, no spaces.
# Anyone not on this list is rejected by BOTH sign-in methods, and no account
# row is created for them. This is the primary access control.
ADMIN_EMAILS=""

# The app's own origin. http://localhost:3000 locally; the live origin in prod.
NEXTAUTH_URL="http://localhost:3000"

# Signs the session cookie. Generate with: openssl rand -base64 32
# Never reuse the local value in production.
NEXTAUTH_SECRET=""

# --- File storage (Todo/03) ---------------------------------------------
# From the Vercel Blob store. Used for CV uploads, blog covers and project
# images. Swap to Cloudinary by changing lib/storage.js if this is unavailable.
BLOB_READ_WRITE_TOKEN=""
