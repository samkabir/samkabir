{
  "name": "portfoliowebsite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/with-env.mjs prisma migrate dev",
    "db:migrate:deploy": "node scripts/with-env.mjs prisma migrate deploy",
    "db:migrate:status": "node scripts/with-env.mjs prisma migrate status",
    "db:migrate:reset": "node scripts/with-env.mjs prisma migrate reset",
    "db:push": "node scripts/with-env.mjs prisma db push",
    "db:studio": "node scripts/with-env.mjs prisma studio",
    "db:smoke": "node scripts/with-env.mjs node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-smoke.mjs",
    "db:seed": "node scripts/with-env.mjs prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:create": "node scripts/with-env.mjs node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/create-admin.mjs",
    "admin:reset-password": "node scripts/with-env.mjs node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/reset-password.mjs",
    "media:prune": "node scripts/with-env.mjs node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prune-media.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/icons-material": "^5.11.0",
    "@mui/material": "^5.11.7",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "aos": "^3.0.0-beta.6",
    "bcryptjs": "^3.0.3",
    "next": "^16.2.3",
    "next-auth": "^4.24.15",
    "prop-types": "^15.8.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "autoprefixer": "^10.4.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "postcss": "^8.4.21",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.2.4",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "node scripts/with-env.mjs node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON prisma/seed.js"
  }
}
